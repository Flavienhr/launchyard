{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "money",
    "facilities",
    "technicians",
    "assignments"
  ],
  "additionalProperties": false,
  "properties": {
    "money": {
      "type": "integer",
      "minimum": 0
    },
    "facilities": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "technicians": {
      "type": "integer",
      "minimum": 0
    },
    "assignments": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    }
  },
  "patternProperties": {
    "^_": {}
  }
}
