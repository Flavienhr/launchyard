{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "suppliers"
  ],
  "additionalProperties": false,
  "properties": {
    "suppliers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "delay_chance",
          "delay_days",
          "catalog"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "name": {
            "type": "string"
          },
          "delay_chance": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "delay_days": {
            "type": "integer",
            "minimum": 0
          },
          "catalog": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "component_id",
                "unit_price",
                "lead_time_days"
              ],
              "additionalProperties": false,
              "properties": {
                "component_id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "unit_price": {
                  "type": "integer",
                  "minimum": 1
                },
                "lead_time_days": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "patternProperties": {
                "^_": {}
              }
            }
          }
        },
        "patternProperties": {
          "^_": {}
        }
      }
    }
  },
  "patternProperties": {
    "^_": {}
  }
}
