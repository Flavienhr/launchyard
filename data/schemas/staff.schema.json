          "minimum": 0
        },
        "fire_cost": {
          "type": "integer",
          "minimum": 0
        },
        "technician_salary_per_day": {
          "type": "integer",
          "minimum": 0
        },
        "max_technicians": {
          "type": "integer",
          "minimum": 0
        }
      },
      "patternProperties": {
        "^_": {}
      }
    },
    "max_queue_length": {
      "type": "integer",
      "minimum": 1
    }
  },
  "patternProperties": {
    "^_": {}
  }
