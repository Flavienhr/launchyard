{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "default_level",
    "levels"
  ],
  "additionalProperties": false,
  "properties": {
    "default_level": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "levels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "briefing",
          "site",
          "order",
          "unlock",
          "duration_days",
          "time_warnings_days",
          "start",
          "stars"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "name": {
            "type": "string"
          },
          "briefing": {
            "type": "string"
          },
          "site": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "unlock": {
            "type": "object",
            "required": [
              "requires_level",
              "min_stars"
            ],
            "additionalProperties": false,
            "properties": {
              "requires_level": {
                "oneOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "min_stars": {
                "type": "integer",
                "minimum": 0,
                "maximum": 3
              }
            }
          },
          "duration_days": {
            "type": "integer",
            "minimum": 0
          },
          "time_warnings_days": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "start": {
            "type": "object",
            "required": [
              "money",
              "facilities",
              "technicians",
              "assignments"
            ],
            "additionalProperties": false,
            "properties": {
              "money": {
                "type": "integer",
                "minimum": 0
              },
              "facilities": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "facility_type",
                    "x",
                    "y",
                    "rotation"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "facility_type": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]*$"
                    },
                    "x": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "y": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "rotation": {
                      "type": "integer",
                      "enum": [
                        0,
                        1
                      ]
                    }
                  }
                }
              },
              "technicians": {
                "type": "integer",
                "minimum": 0
              },
              "assignments": {
                "type": "object",
                "propertyNames": {
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "additionalProperties": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "owned_lots": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                }
              }
            },
            "patternProperties": {
              "^_": {}
            }
          },
          "stars": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "object",
              "required": [
                "name",
                "objectives"
              ],
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string"
                },
                "objectives": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "id",
                      "metric",
                      "op",
                      "target"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_]*$"
                      },
                      "metric": {
                        "enum": [
                          "contracts_completed",
                          "net_cash",
                          "reputation",
                          "in_house_share_pct",
                          "supply_completed_value",
                          "site_violations"
                        ]
                      },
                      "op": {
                        "enum": [
                          "gte",
                          "lte"
                        ]
                      },
                      "target": {
                        "type": "integer"
                      }
                    }
                  }
                },
                "any_of": {
                  "type": "object",
                  "required": [
                    "min_met",
                    "objectives"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "min_met": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "objectives": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "id",
                          "metric",
                          "op",
                          "target"
                        ],
                        "additionalProperties": false,
                        "properties": {
                          "id": {
                            "type": "string",
                            "pattern": "^[a-z][a-z0-9_]*$"
                          },
                          "metric": {
                            "enum": [
                              "contracts_completed",
                              "net_cash",
                              "reputation",
                              "in_house_share_pct",
                              "supply_completed_value",
                              "site_violations"
                            ]
                          },
                          "op": {
                            "enum": [
                              "gte",
                              "lte"
                            ]
                          },
                          "target": {
                            "type": "integer"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "patternProperties": {
    "^_": {}
  }
}
