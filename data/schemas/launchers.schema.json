{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "launchers"
  ],
  "additionalProperties": false,
  "properties": {
    "launchers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "recipe_id",
          "payload_kg",
          "reliability_base",
          "reliability_gain_per_success",
          "reliability_max"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "recipe_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "payload_kg": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": {
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            }
          },
          "reliability_base": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "reliability_gain_per_success": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "reliability_max": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "patternProperties": {
          "^_": {}
        }
      }
    }
  },
  "patternProperties": {
    "^_": {}
  }
}
