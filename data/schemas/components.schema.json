{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "components"
  ],
  "additionalProperties": false,
  "properties": {
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "mass_kg",
          "storage_units"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "name": {
            "type": "string"
          },
          "mass_kg": {
            "type": "integer",
            "minimum": 1
          },
          "storage_units": {
            "type": "integer",
            "minimum": 1
          }
        },
        "patternProperties": {
          "^_": {}
        }
      }
    }
  },
  "patternProperties": {
    "^_": {}
  }
}
